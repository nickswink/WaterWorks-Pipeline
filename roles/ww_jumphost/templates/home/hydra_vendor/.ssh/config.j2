# Hydra Controls Integration - remote support jump config.
# From this jump host the engineering workstation is reachable with the
# vendor key only. `ssh ww-eng01` picks up the identity below.

Host ww-eng01
    HostName {{ ww_net }}.40.20
    User hydra_vendor
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking no
